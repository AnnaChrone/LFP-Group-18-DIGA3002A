  gapBetweenLines: 0.3
  sequences:
  - name: Intro
    playOnStart: 1
    playOnce: 1
    lines:
    - type: 0
      speaker: 
      text: Fish by the water, then bring your catch back to the restaurant to make
        sushi.
      holdSeconds: 0
    onFinished:
      m_PersistentCalls:
        m_Calls: []
  - name: FirstBait
    playOnStart: 0
    playOnce: 1
    lines:
    - type: 1
      speaker: 
      text: Pick your bait before you cast, because better bait brings better fish.
      holdSeconds: 0
    onFinished:
      m_PersistentCalls:
        m_Calls: []
  - name: FirstCatch
    playOnStart: 0
    playOnce: 1
    lines:
    - type: 4
      speaker: 
      text: Nice catch! Take it back to the restaurant to turn it into sushi.
      holdSeconds: 0
    onFinished:
      m_PersistentCalls:
        m_Calls: []
  - name: ToRestaurant
    playOnStart: 0
    playOnce: 1
    lines:
    - type: 6
      speaker: 
      text: Time to head back and see what the restaurant needs tonight.
      holdSeconds: 0
    onFinished:
      m_PersistentCalls:
        m_Calls: []
  - name: FirstService
    playOnStart: 0
    playOnce: 1
    lines:
    - type: 0
      speaker: 
      text: Service has begun. Check your order slips and make the sushi customers
        ask for.
      holdSeconds: 0
    onFinished:
      m_PersistentCalls:
        m_Calls: []
