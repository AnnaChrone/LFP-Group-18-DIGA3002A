--- !u!114 &1176243606
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1176243605}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8e1e0ebb150fcbb4b9bbfb7954088a25, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NarrationSequencePlayer
  ui: {fileID: 1000290973}
  playerName: Player
  defaultHoldSeconds: 2.5
  gapBetweenLines: 0.3
  minSecondsBetweenSequences: 6
  sequences:
  - name: Intro
    playOnStart: 1
    playOnce: 1
    lines:
    - type: 0
      speaker: 
      text: "Kenji\u2019s grandfather founded this sushi shop by the sea, and tonight
        it opens again."
      holdSeconds: 0
    onFinished:
      m_PersistentCalls:
        m_Calls: []
  - name: Stakes
    playOnStart: 1
    playOnce: 1
    lines:
    - type: 1
      speaker: 
      text: 'The landdlord wants to reclaim it by month''s end.

        One great
        week of sushi could change that'
      holdSeconds: 0
    onFinished:
      m_PersistentCalls:
        m_Calls: []
  - name: GrandfatherAdvice
    playOnStart: 0
    playOnce: 1
    lines:
    - type: 2
      speaker: Grandfather
      text: Fresh fish makes the sushi, Kenji, never the other way around.
      holdSeconds: 0
    onFinished:
      m_PersistentCalls:
        m_Calls: []
  - name: DockArrive
    playOnStart: 0
    playOnce: 1
    lines:
    - type: 0
      speaker: 
      text: The sea is calm tonight, and the tide is on your side.
      holdSeconds: 0
    onFinished:
      m_PersistentCalls:
        m_Calls: []
  - name: FirstSit
    playOnStart: 0
    playOnce: 1
    lines:
    - type: 1
      speaker: 
      text: 'Sit down, breathe and wait.

        Patience is half of fishing'
      holdSeconds: 0
    onFinished:
      m_PersistentCalls:
        m_Calls: []
  - name: FirstBait
    playOnStart: 0
    playOnce: 1
    lines:
    - type: 1
      speaker: 
      text: The right bait determines your catch, so pick carefully
      holdSeconds: 0
    onFinished:
      m_PersistentCalls:
        m_Calls: []
  - name: FirstCast
    playOnStart: 0
    playOnce: 1
    lines:
    - type: 1
      speaker: 
      text: Cast gently, because fish can hear impatience
      holdSeconds: 0
    onFinished:
      m_PersistentCalls:
        m_Calls: []
  - name: FirstBite
    playOnStart: 0
    playOnce: 1
    lines:
    - type: 1
      speaker: 
      text: Here comes the tug, get ready!
      holdSeconds: 0
    onFinished:
      m_PersistentCalls:
        m_Calls: []
  - name: ReelTension
    playOnStart: 0
    playOnce: 1
    lines:
    - type: 2
      speaker: 
      text: Keep the line steady. Too tight and it snaps, too loose and it escapes
      holdSeconds: 0
    onFinished:
      m_PersistentCalls:
        m_Calls: []
  - name: FirstCatch
    playOnStart: 0
    playOnce: 1
    lines:
    - type: 4
      speaker: 
      text: 'Your first catch of the night!

        Grandfather would be proud.'
      holdSeconds: 0
    onFinished:
      m_PersistentCalls:
        m_Calls: []
  - name: LineSnap
    playOnStart: 0
    playOnce: 0
    lines:
    - type: 5
      speaker: 
      text: 'The line snapped.

        Even masters lose fish, so try again'
      holdSeconds: 0
    onFinished:
      m_PersistentCalls:
        m_Calls: []
  - name: OutOfBait
    playOnStart: 0
    playOnce: 0
    lines:
    - type: 5
      speaker: 
      text: The bait box is empty. Visit the bait shop before the tide turns.
      holdSeconds: 0
    onFinished:
      m_PersistentCalls:
        m_Calls: []
  - name: BaitShopVisit
    playOnStart: 0
    playOnce: 1
    lines:
    - type: 2
      speaker: 
      text: 'Fresh bait for fresh food!

        Your grandfather bought from here
        too'
      holdSeconds: 0
    onFinished:
      m_PersistentCalls:
        m_Calls: []
  - name: ToRestaurant
    playOnStart: 0
    playOnce: 1
    lines:
    - type: 6
      speaker: 
      text: Time to carry the day's catch back to the restaurant
      holdSeconds: 0
    onFinished:
      m_PersistentCalls:
        m_Calls: []
  - name: RestaurantArrive
    playOnStart: 0
    playOnce: 1
    lines:
    - type: 0
      speaker: 
      text: The lanterns are lit and the counter is ready, make each night count!
      holdSeconds: 0
    onFinished:
      m_PersistentCalls:
        m_Calls: []
  - name: FirstService
    playOnStart: 0
    playOnce: 1
    lines:
    - type: 0
      speaker: 
      text: Service has begun. Check your order slips!
      holdSeconds: 0
    onFinished:
      m_PersistentCalls:
        m_Calls: []
  - name: FirstOrder
    playOnStart: 0
    playOnce: 1
    lines:
    - type: 1
      speaker: 
      text: Your first customer! Match their order with the fish you caught earlier
      holdSeconds: 0
    onFinished:
      m_PersistentCalls:
        m_Calls: []
  - name: NoIngredients
    playOnStart: 0
    playOnce: 0
    lines:
    - type: 5
      speaker: 
      text: Not enough fish for that order. Go back to the dock and cast again!
      holdSeconds: 0
    onFinished:
      m_PersistentCalls:
        m_Calls: []
  - name: FirstSushiServed
    playOnStart: 0
    playOnce: 1
    lines:
    - type: 4
      speaker: 
      text: The first plate is served!
      holdSeconds: 0
    onFinished:
      m_PersistentCalls:
        m_Calls: []
  - name: NightEnd
    playOnStart: 0
    playOnce: 1
    lines:
    - type: 0
      speaker: 
      text: Service has ended, head back to the dock when you're ready for a new
        day!
      holdSeconds: 0
    onFinished:
      m_PersistentCalls:
        m_Calls: []
